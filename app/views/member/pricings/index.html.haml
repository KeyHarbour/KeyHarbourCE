
= simple_form_for [:member, @coupon_subscription]  do |f|
  .col-md-12
    .card
      .card-header
        %h3.card-title= t('.coupon.title')
      .card-body
        .text-sm.text-foreground.mb-2= t('.coupon.text')
        = f.input :coupon_code, label: false, placeholder: t('.coupon.input')

      .card-footer.text-end
        .d-flex
          %button.btn.btn-primary.ms-auto{:type => "submit"}=  t('globals.save')

.col-md-12
  .card
    .card-body{ data: { controller: "pricing" } }
      .row.mt-2
        .col-md-6.text-end
        .col-md-3
          %label.form-check
            %input.form-check-input{:name => "billing", :checked => "checked", :value => "monthly", :type => "radio", data: { action: "change->pricing#toggle" }}/
            %h3= t('.monthly_billing')
        .col-md-3
          %label.form-check
            %input.form-check-input{:name => "billing", :value => "annual", :type => "radio", data: { action: "change->pricing#toggle" }}/
            %h3= t('.annual_billing')
.col-md-12
  .row.row-cards
    - Plan.all.each_with_index do |plan, index|
      .col-sm-6.col-lg-3
        .card.card-md
          .ribbon.ribbon-top.ribbon-bookmark.bg-green
            / Download SVG icon from http://tabler.io/icons/icon/star
            %svg.icon{"aria-hidden" => "true", :fill => "none", :focusable => "false", :height => "24", :stroke => "currentColor", "stroke-linecap" => "round", "stroke-linejoin" => "round", "stroke-width" => "2", :viewbox => "0 0 24 24", :width => "24", :xmlns => "http://www.w3.org/2000/svg"}
              %path{:d => "M12 17.75l-6.172 3.245l1.179 -6.873l-5 -4.867l6.9 -1l3.086 -6.253l3.086 6.253l6.9 1l-5 4.867l1.179 6.873l-6.158 -3.245"}
          .card-body.text-center
            .text-uppercase.text-secondary.fw-medium= plan.name
            .display-6.fw-bold.my-3
              - if plan.available != false
                .price.monthly-prices{ data: { pricing_target: "monthly" } }
                  = plan.price == 0 ? "Free" : number_to_currency(plan.price, unit: "$")
                .price.annual-prices.d-none{ data: { pricing_target: "annual" } }
                  = plan.price_annual == 0 ? "Free" : number_to_currency(plan.price_annual, unit: "$")
              - else
                = t('.contact-us')
            %ul.list-unstyled.lh-lg
              %li.mb-3
                %strong= t('.unlimited')
                = t('.user_accounts')
              %li.mb-3
                / Download SVG icon from http://tabler.io/icons/icon/x
                = icon "check", class: "text-green"
                Terraform statefile
              %li.mb-3
                / Download SVG icon from http://tabler.io/icons/icon/x
                = icon "check", class: "text-green"
                #{t('.unlimited_terraform_ressources')}
              %li.mb-3
                / Download SVG icon from http://tabler.io/icons/icon/x
                = icon "check", class: "text-green"
                Key value Store
              %li.mb-3
                / Download SVG icon from http://tabler.io/icons/icon/x
                = icon "check", class: "text-green"
                SSL inventory
              %li.mb-3
                / Download SVG icon from http://tabler.io/icons/icon/x
                = icon "check", class: "text-green"
                Token inventory
              %li.mb-3
                / Download SVG icon from http://tabler.io/icons/icon/x
                = icon "check", class: "text-green"
                App. Licenses
              %li.mb-3
                #{t('.api_queries').pluralize} / #{t('.month')} : #{number_with_delimiter plan.credits}

              %li.mb-3
                #{t('.additional_package')} : #{number_to_currency plan.price_package} / #{number_with_delimiter plan.credits} #{t('.queries')}
            .text-center.mt-4
              - if plan.available == false
                %h3= t('.soon')
              - elsif Current.subscription.plan_id == plan.id
                .alert.alert-success
                  .alert-icon= icon "check"
                  = t('.current_plan')
              - else
                .price.monthly-prices= button_to t('.select'), member_subscriptions_path(plan: plan.id, period: "month"), method: :post, data: { turbo: false }, class: "btn w-100"
                .price.annual-prices.d-none= button_to t('.select'), member_subscriptions_path(plan: plan.id, period: "year"), method: :post, data: { turbo: false }, class: "btn w-100"

            .text-secondary-foreground.text-sm.mt-4
              = raw plan.description
