= turbo_frame_tag dom_id(@item, :id) do
  = simple_form_for @item, url: form_url, class: "d-flex align-items-center gap-2" do |f|
    = render partial: "form_error", locals: { form_table: @item }
    .form-group.mb-0
      = f.text_field :uuid, class: "form-control form-control-sm", autofocus: true

    = f.submit "Enregistrer", class: "btn btn-sm"
    = link_to "Annuler", member_statefile_path(@item), class: "btn btn-sm btn-link text-muted"
