%ul.nav.nav-tabs.card-header-tabs{"data-bs-toggle" => "tabs", :role => "tablist"}
  %li.nav-item{:role => "presentation"}
    = link_to member_organization_path(organization), class: "nav-link #{actif=='organization' ? 'active' : ''}", "aria-selected" => "false", :tabindex => "-1" do
      = t('.profile')
  %li.nav-item{:role => "presentation"}
    = link_to member_organization_environments_path(organization), class: "nav-link #{actif=='environments' ? 'active' : ''}", "aria-selected" => "false", :tabindex => "-1" do
      = t('activerecord.models.environment').pluralize
  %li.nav-item{:role => "presentation"}
    = link_to member_organization_projects_path(organization), class: "nav-link #{actif=='projects' ? 'active' : ''}", "aria-selected" => "false", :tabindex => "-1" do
      = t('activerecord.models.project').pluralize
  %li.nav-item{:role => "presentation"}
    = link_to member_organization_org_tokens_path(organization), class: "nav-link #{actif=='tokens' ? 'active' : ''}", "aria-selected" => "false", :tabindex => "-1" do
      = t('activerecord.models.token').pluralize
