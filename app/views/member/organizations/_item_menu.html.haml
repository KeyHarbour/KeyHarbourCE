.kt-menu{"data-kt-menu" => "true"}
  .kt-menu-item.kt-menu-item-dropdown{"data-kt-menu-item-offset" => "0, 10px", "data-kt-menu-item-placement" => "bottom-end", "data-kt-menu-item-placement-rtl" => "bottom-start", "data-kt-menu-item-toggle" => "dropdown", "data-kt-menu-item-trigger" => "click"}
    %button.kt-menu-toggle.kt-btn.kt-btn-sm.kt-btn-icon.kt-btn-ghost
      %i.ki-filled.ki-dots-vertical.text-lg
    .kt-menu-dropdown.kt-menu-default.w-full{:class => "max-w-[175px]", "data-kt-menu-dismiss" => "true", :style => ""}


      - if local_assigns.key?(:push_link)   
        .kt-menu-item
          = link_to push_link, class: "kt-menu-link", method: :put, data:  { turbo_method: :put, turbo_confirm: t('globals.confirm_push') } do
            %span.kt-menu-icon
              %i.ki-filled.ki-pencil
            %span.kt-menu-title
              = t('.push_as_current')

      - if local_assigns.key?(:edit_link)
        .kt-menu-item
          = link_to edit_link, class: "kt-menu-link" do
            %span.kt-menu-icon
              %i.ki-filled.ki-pencil
            %span.kt-menu-title
              = t('.update')

      - if local_assigns.key?(:duplicate_link)   
        .kt-menu-item
          = link_to duplicate_link, class: "kt-menu-link", method: :put, data:  { turbo_method: :put, turbo_confirm: t('globals.confirm_copy') } do
            %span.kt-menu-icon
              %i.ki-filled.ki-pencil
            %span.kt-menu-title
              = t('.copy')

      - if local_assigns.key?(:token_link)   
        .kt-menu-item
          = link_to token_link, class: "kt-menu-link" do
            %span.kt-menu-icon
              %i.ki-filled.ki-pencil
            %span.kt-menu-title
              = t('.tokens')

      - if local_assigns.key?(:delete_link)  
        .kt-menu-separator
        .kt-menu-item
          = link_to delete_link, class: "kt-menu-link", method: :delete, data:  { turbo_method: :delete, turbo_confirm: t('globals.confirm') } do
            %span.kt-menu-icon
              %i.ki-filled.ki-trash
            %span.kt-menu-title
              = t('.remove')