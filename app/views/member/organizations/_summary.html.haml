.card
  .card-header
    %h3.card-title= t('application.org_menu.profile')
    .card-actions
      = link_to edit_member_organization_path(organization) do
        = t('.update')
        %svg.icon.ms-1.icon-2{:fill => "none", :height => "24", :stroke => "currentColor", "stroke-linecap" => "round", "stroke-linejoin" => "round", "stroke-width" => "2", :viewbox => "0 0 24 24", :width => "24", :xmlns => "http://www.w3.org/2000/svg"}
          %path{:d => "M7 7h-1a2 2 0 0 0 -2 2v9a2 2 0 0 0 2 2h9a2 2 0 0 0 2 -2v-1"}
          %path{:d => "M20.385 6.585a2.1 2.1 0 0 0 -2.97 -2.97l-8.415 8.385v3h3l8.385 -8.415z"}
          %path{:d => "M16 5l3 3"}
  .card-body
    %dl.row
      %dt.col-5= t('activerecord.models.project').pluralize
      %dd.col-7.text-end= organization.projects.count
      %dt.col-5= t('activerecord.models.workspace').pluralize
      %dd.col-7.text-end= organization.workspaces.count
      %dt.col-5= t('.resources')
      %dd.col-7.text-end 0
      %dt.col-5= t('.key_value_store')
      %dd.col-7.text-end= organization.key_value_stores.count
      %dt.col-5= t('.trust_assets')
      %dd.col-7.text-end= organization.trust_assets.count