%td
  #{item.key}
%td.text-center
  = item.expires_at.to_date if item.expires_at
%td.text-center= item.private == true ? "***" : item.value
%td.text-center= item.private == true  ? t('globals.bool_yes') : t('globals.bool_no')
%td.text-center= item.one_time_only == true  ? t('globals.bool_yes') : t('globals.bool_no')
%td.text-center
  .dropdown.no-arrow
    %a.dropdown-toggle.text-secondary{"aria-expanded" => "false", "aria-haspopup" => "true", "aria-label" => "Select time range for revenue", "data-bs-toggle" => "dropdown", :href => "#"}= icon "dots-vertical"
    .dropdown-menu.dropdown-menu-end{"aria-labelledby" => "revenue-dropdown", :style => ""}
      = link_to edit_member_key_value_store_path(item), class: "dropdown-item" do
        = icon "edit"
        = t('.update')
      .dropdown-divider
      = link_to member_key_value_store_path(item), class: "dropdown-item", method: :delete, data:  { turbo_method: :delete, turbo_confirm: "Confirm ?" } do
        = icon "trash"
        = t('.remove')