= simple_form_for item, url: member_workspace_key_value_stores_path(@workspace), method: :get, html: {class: "simple_form"}  do |f|
  = render partial: "form_error", locals: { form_table: item }
  .mt-3
    = f.input :key
  .mb-3
    = f.input :private
  .mb-3
    = f.input :one_time_only
  .mt-3
    = f.input :environment_id, as: :hidden
  .mt-3
    = f.submit 'Search', class: 'btn btn-primary'