- if params[:field] == "amount"
  = turbo_frame_tag [dom_id(@quote_application), :amount] do
    = simple_form_for @quote_application, url: member_license_quote_application_path(@quote_application, locale: I18n.locale), method: :patch, html: { data: { turbo_frame: "_top" } } do |f|
      .mb-2
        = f.text_field :amount, class: "form-control form-control-sm", style: "max-width: 150px;"

      .d-flex.justify-content-end.gap-2.align-items-center
        = link_to t('.cancel'), member_license_quote_application_path(@quote_application, locale: I18n.locale), class: "btn-cancel btn-sm text-nowrap", style: "font-size: 12px;"
        %button.btn.btn-primary.btn-sm.text-nowrap{ type: "submit" } #{t('.ok')}
- if params[:field] == "seats"
  = turbo_frame_tag [dom_id(@quote_application), :seats] do
    = simple_form_for @quote_application, url: member_license_quote_application_path(@quote_application, locale: I18n.locale), method: :patch, html: { data: { turbo_frame: "_top" } } do |f|
      .mb-2
        = f.text_field :seats, class: "form-control form-control-sm", style: "max-width: 150px;"
      .d-flex.justify-content-end.gap-2.align-items-center
        = link_to t('.cancel'), member_license_quote_application_path(@quote_application, locale: I18n.locale), class: "btn-cancel btn-sm text-nowrap", style: "font-size: 12px;"
        %button.btn.btn-primary.btn-sm.text-nowrap{ type: "submit" } #{t('.ok')}
