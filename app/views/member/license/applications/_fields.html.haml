    = f.input :seats  
  .flex-1.pr-2
    = f.input :unit_cost
.flex
  .flex-1.pr-2
    = f.input :alert_renewal_1
  .flex-1.pr-2
    = f.input :alert_renewal_2     
.flex
  .flex-1.pr-2
    = f.input :alert_seats_1
  .flex-1.pr-2
    = f.input :alert_seats_2  
.w-full
  = f.input :logo, as: :file, hint: f.object.logo.attached? ? image_tag(f.object.logo.variant(resize_to_limit: [100, 100])) : content_tag(:span, t('globals.no_logo_uploaded'))