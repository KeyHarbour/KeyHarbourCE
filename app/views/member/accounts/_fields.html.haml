.w-full.mt-4.mb-4
  = f.input :name, hint: t("activerecord.hints.account.name")
.w-full.mb-4
  = f.input :billing_contact, input_html: { value: @item.billing_contact || Current.user.email_address }
.w-full.mb-4   
  = f.input :address1  
.w-full.mb-4  
  = f.input :address2  
.w-full.mb-4  
  = f.input :zip
.w-full.mb-4  
  = f.input :city  
.country{ "data-controller" => "location"}
  .w-full.mb-4
    = f.input :country_code,
      as: :country,
      prompt: t('.select'),
      priority: ["CA", "FR"],
      input_html: { data: { action: "change->location#updateProvinces", location_target: "country" } }
  .w-full.mb-4
    = f.input :province_code,
      collection: province_options(f.object.country_code), wrapper: "horizontal_form",
      prompt: t('.select'),
      input_html: { data: { location_target: "province" } }