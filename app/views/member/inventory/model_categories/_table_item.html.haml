%td.col-md-1.text-center
  %span.badge{class: "#{item.active? ? 'bg-green' : 'bg-red'}"}
%td= item.name
%td.text-center= item.resource_type
%td.text-center= item.model_family.name
%td.text-center= item.model_category_attrs.count
%td
  .dropdown.no-arrow
    %a.dropdown-toggle.text-secondary{"aria-expanded" => "false", "aria-haspopup" => "true", "aria-label" => "Select time range for revenue", "data-bs-toggle" => "dropdown", :href => "#"}= icon "dots-vertical"
    .dropdown-menu.dropdown-menu-end{"aria-labelledby" => "revenue-dropdown", :style => ""}
      = link_to edit_member_inventory_model_category_path(item), class: "dropdown-item" do
        = icon "edit"
        = t('.update')
      = link_to member_inventory_model_category_attrs_path(item), class: "dropdown-item" do
        = icon "chart-column"
        = t('.attributs')
      .dropdown-divider
      = link_to member_inventory_model_category_path(item), class: "dropdown-item", method: :delete, data:  { turbo_method: :delete, turbo_confirm: "Confirm ?" } do
        = icon "trash"
        = t('.remove')
