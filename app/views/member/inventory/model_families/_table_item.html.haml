%td
  = item.name
%td.text-center
  .dropdown.no-arrow
    %a.dropdown-toggle.text-secondary{"aria-expanded" => "false", "aria-haspopup" => "true", "aria-label" => "Select time range for revenue", "data-bs-toggle" => "dropdown", :href => "#"}= icon "dots-vertical"
    .dropdown-menu.dropdown-menu-end{"aria-labelledby" => "revenue-dropdown", :style => ""}
      = link_to edit_member_inventory_model_family_path(item), class: "dropdown-item" do
        = icon "edit"
        = t('.update')
      .dropdown-divider
      = link_to member_inventory_model_family_path(item), class: "dropdown-item", method: :delete, data:  { turbo_method: :delete, turbo_confirm: "Confirm ?" } do
        = icon "trash"
        = t('.remove')
