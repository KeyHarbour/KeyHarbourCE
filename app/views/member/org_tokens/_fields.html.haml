= f.input :scopable_type, as: :hidden
.w-full
  = f.input :name
.w-full
  = f.input :expiration, as: :string, input_html: { value: DateTime.now.advance(days: 7), data: { controller: "datepicker", datepicker_max_date_value: DateTime.now.advance(years: 1, days: -1) } }
.mb-3
  = f.association :environment,
    collection: @organization.environments.all.pluck(:name, :id),
    as: :select,
    wrapper: :horizontal_form,
    include_blank: true,
    input_html: { multiple: false, data: { controller: "tom-select" } },
    hint: t('activerecord.hints.token.environment_id')
= f.input :organization_id, as: :hidden, input_html: { value: @organization&.id}


#monOffcanvasElement.offcanvas.offcanvas-end{:tabindex => "-1"}
  .offcanvas-header
    %h5.offcanvas-title Détails du Token
    %button.btn-close{"data-bs-dismiss" => "offcanvas", :type => "button"}
  / C'est cet ID que le contrôleur cible pour injecter le partial
  #offcanvas_container.offcanvas-body
