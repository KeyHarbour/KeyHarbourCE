%tr
  %td= ta.name
  %td
    %span.badge.me-1{class: expires_color(ta)}
    = ta.expires_at.to_date
- if ta.expiry_level == 2
  %tr
    %td{:colspan => "2"}
      .alert.alert-danger{:role => "alert"}
        .alert-icon
          = icon "alert-circle"
        This item is already expired
- if ta.expiry_level == 1
  %tr
    %td{:colspan => "2"}
      .alert.alert-warning{:role => "alert"}
        .alert-icon
          = icon "alert-triangle"
        This item will expire soon. Please take action to renew it.