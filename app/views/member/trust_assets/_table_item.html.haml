%td
  #{item.name}
  .d-block.text-secondary.text-truncate.mt-1= truncate(item.description, length: 30)
%td.text-center
  #{item.expires_at&.to_date}
%td.text-center
  #{item.issuer}
%td.text-center
  #{item.consumer}
%td.text-center
  #{item.format}
%td.text-center
  .dropdown.no-arrow
    %a.dropdown-toggle.text-secondary{"aria-expanded" => "false", "aria-haspopup" => "true", "aria-label" => "Select time range for revenue", "data-bs-toggle" => "dropdown", :href => "#"}= icon "dots-vertical"
    .dropdown-menu.dropdown-menu-end{"aria-labelledby" => "revenue-dropdown", :style => ""}
      = link_to edit_member_trust_asset_path(item), class: "dropdown-item" do
        = icon "edit"
        = t('.update')
      .dropdown-divider
      = link_to member_trust_asset_path(item), class: "dropdown-item", method: :delete, data:  { turbo_method: :delete, turbo_confirm: "Confirm ?" } do
        = icon "trash"
        = t('.remove')