%div{"data-controller" => "offcanvas", "data-offcanvas-onload-value" => "true"}
  #offcanvasTop.offcanvas.offcanvas-top{"aria-labelledby" => "offcanvasTopLabel", "data-offcanvas-target" => "panel", tabindex: "-1"}
    .offcanvas-header
      %h2#offcanvasTopLabel.offcanvas-title
        Token : #{@item.name}
        = distance_of_time_in_words(Time.current, @item.expiration)
        (expires at #{@item.expiration.strftime("%Y-%m-%d %H:%M")})
      %button.btn-close.text-reset{"aria-label" => "Close", "data-bs-dismiss" => "offcanvas", type: "button"}
    .offcanvas-body
      .alert.alert-danger.alert-dismissible{:role => "alert"}
        .alert-icon
          %svg.icon.alert-icon.icon-2{:fill => "none", :height => "24", :stroke => "currentColor", "stroke-linecap" => "round", "stroke-linejoin" => "round", "stroke-width" => "2", :viewbox => "0 0 24 24", :width => "24", :xmlns => "http://www.w3.org/2000/svg"}
            %path{:d => "M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0"}
            %path{:d => "M12 8v4"}
            %path{:d => "M12 16h.01"}
        = t('views.member.tokens.token_visibility_warning')
      .alert.alert-info{:role => "alert"}
        %span{id: "text_#{@item.id}"}
          = @item.generate_token_for(:statefile)
        = link_to "#", id: "btn_#{@item.id}", :onclick => "copierTexte('text_#{@item.id}', 'btn_#{@item.id}')" do
          = icon "copy", class: "icon-xs"
