= f.input :scopable_type, as: :hidden
.mb-3
  = f.input :name
.mb-3
  = f.input :expiration, as: :string, input_html: { value: DateTime.now.advance(days: 7), data: { controller: "datepicker", datepicker_max_date_value: DateTime.now.advance(years: 1, days: -1) } }
.mb-3
  = f.association :environment,
    collection: @project.environments.all.pluck(:name, :id),
    as: :select,
    wrapper: :horizontal_form,
    include_blank: true,
    input_html: { multiple: false, data: { controller: "tom-select" } },
    hint: t('activerecord.hints.token.environment_id')
.mb-3
  = f.input :workspace_id, collection: @project.workspaces.current_user(Current), wrapper: :horizontal_form, as: :select, input_html: { multiple: false, data: { controller: "tom-select" } }, hint: t('.leave_blank_project_token')
= f.input :project_id, as: :hidden, input_html: { value: @project&.id}