= simple_form_for item, url: member_project_tokens_path(@project), method: :get, html: {class: "simple_form"}  do |f|
  = render partial: "form_error", locals: { form_table: item }
  .mb-3
    = f.input :name
  .mb-3
    = f.association :environment,
      collection: @project.environments.all.pluck(:name, :id),
      as: :select,
      include_blank: true,
      input_html: { multiple: false, data: { controller: "tom-select" } },
      hint: t('activerecord.hints.token.environment_id')
  .mb-3
    = f.input :workspace_id, collection: @project.workspaces.current_user(Current), as: :select, input_html: { multiple: false, data: { controller: "tom-select" } }, hint: t('.leave_blank_project_token')
  .mt-3
    = f.submit 'Search', class: 'btn btn-primary'