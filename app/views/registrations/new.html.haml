.card.card-md
  .card-body
    %h2.h2.text-center.mb-4= t(".title")
    .text-center.text-xs.text-center.mb-4
      = t('.already_have_account')
      = link_to t('.log_in'), new_session_path, class: "text-sm link"
    = form_with model: @user, url: registration_url do |form|
      = tag.div(flash[:alert], style: "color:red") if flash[:alert]
      = tag.div(flash[:notice], style: "color:green") if flash[:notice]
      .mb-3
        %label.form-label= t("activerecord.attributes.user.email_address")
        = form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: t('activerecord.placeholders.user.email_address'), value: params[:email_address], class: "form-control"
      .mb-2
        %label.form-label
          = t("activerecord.attributes.user.password")
          %span.form-label-description
            = link_to new_password_path do
              = t(".forgot_password")
        .input-group.input-group-flat
          = form.password_field :password, required: true, autocomplete: "current-password", placeholder: t('activerecord.placeholders.user.password'), maxlength: 72, class: "form-control"
      .mb-2
        %label.form-label
          = t("activerecord.attributes.user.password_confirmation")
        .input-group.input-group-flat
          = form.password_field :password_confirmation, required: true, autocomplete: "current-password", placeholder: t('activerecord.placeholders.user.password_confirmation'), maxlength: 72, class: "form-control"
      .form-footer
        %label.kt-checkbox-group.text-sm.mb-2
          %input.kt-checkbox.kt-checkbox-sm{:name => "acceptTermsstd", :type => "checkbox", :value => "1", id: "acceptTermsStd", onchange: "toggleSubmitButtonStd()"}/
          %span.kt-checkbox-label
            = t('.accept')
            %a.text-sm.link.kt-link-underlined.kt-link-dashed{:href => "https://docs.keyharbour.ca/terms-and-conditions/", target: "_blank"}
              = t('.conditions')
        %button.btn.btn-primary.submitBtnGG.w-100{:type => "submit", id: "submitBtnStd", disabled: true}= t(".title")

  - if KeyHarbour.oauth_google? || KeyHarbour.oauth_microsoft? || KeyHarbour.oauth_github? 
    .hr-text or
    .card-body
      .row
        - if KeyHarbour.oauth_google? || KeyHarbour.oauth_microsoft? || KeyHarbour.oauth_github? 
          .col
            %label.kt-checkbox-group.text-sm.mb-2
              %input.kt-checkbox.kt-checkbox-sm{:name => "acceptTerms", :type => "checkbox", :value => "1", id: "acceptTermsGG", onchange: "toggleSubmitButtonGG()"}/
              %span.kt-checkbox-label
                = t('.accept')
                %a.text-sm.link.kt-link-underlined.kt-link-dashed{:href => "https://docs.keyharbour.ca/terms-and-conditions/", target: "_blank"}
                  = t('.conditions')
      - if KeyHarbour.oauth_google?
        .row.mb-3
          .col
            = button_to '/auth/google_oauth2', method: :post, data: { turbo: false }, disabled: true, class: "submitBtnGG btn btn-4 w-100" do
              = icon "brand-google"
              Signup with Google
      - if KeyHarbour.oauth_microsoft?
        .row.mb-3
          .col
            = button_to '/auth/microsoft_graph', method: :post, data: { turbo: false }, disabled: true, class: "submitBtnGG btn btn-4 w-100" do
              = icon "brand-entra"
              Login with Microsoft
      - if KeyHarbour.oauth_github?
        .row.mb-3
          .col
            = button_to '/auth/github', method: :post, data: { turbo: false }, disabled: true, class: "submitBtnGG btn btn-4 w-100" do
              = icon "brand-github"
              Login with Github

:javascript
  function toggleSubmitButtonGG() {
    const checkbox = document.getElementById('acceptTermsGG');
    const submitButtons = document.querySelectorAll('.submitBtnGG');
    submitButtons.forEach(btn => {
        btn.disabled = !checkbox.checked;
    });
  }
  function toggleSubmitButtonStd() {
    const checkbox = document.getElementById('acceptTermsStd');
    const submitButtons = document.querySelectorAll('.submitBtnGG');
    submitButtons.forEach(btn => {
        btn.disabled = !checkbox.checked;
    });
  }
