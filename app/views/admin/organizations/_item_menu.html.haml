.kt-menu{"data-kt-menu" => "true"}
  .kt-menu-item.kt-menu-item-dropdown{"data-kt-menu-item-offset" => "0, 10px", "data-kt-menu-item-placement" => "bottom-end", "data-kt-menu-item-placement-rtl" => "bottom-start", "data-kt-menu-item-toggle" => "dropdown", "data-kt-menu-item-trigger" => "click"}
    %button.kt-menu-toggle.kt-btn.kt-btn-sm.kt-btn-icon.kt-btn-ghost
      %i.ki-filled.ki-dots-vertical.text-lg
    .kt-menu-dropdown.kt-menu-default.w-full{:class => "max-w-[175px]", "data-kt-menu-dismiss" => "true", :style => ""}
      .kt-menu-item
        = link_to edit_link, class: "kt-menu-link" do
          %span.kt-menu-icon
            %i.ki-filled.ki-pencil
          %span.kt-menu-title
            = t('globals.edit')
      .kt-menu-item
        = link_to token_link, class: "kt-menu-link" do
          %span.kt-menu-icon
            %i.ki-filled.ki-pencil
          %span.kt-menu-title
            = t('admin.organizations.tokens')
      .kt-menu-separator
      .kt-menu-item
        = link_to delete_link, class: "kt-menu-link", method: :delete, data:  { turbo_method: :delete, turbo_confirm: t('globals.confirm') } do
          %span.kt-menu-icon
            %i.ki-filled.ki-trash
          %span.kt-menu-title
            = t('admin.organizations.archive')