= simple_form_for item, url: admin_users_path(), method: :get, html: {class: "simple_form"}  do |f|
  = render partial: "form_error", locals: { form_table: item }
  .mt-3
    = f.input :email_address
  .mt-3
    = f.input :account_name, collection: Account.all.pluck(:name).uniq
  .mt-3
    = f.submit 'Search', class: 'btn btn-primary'