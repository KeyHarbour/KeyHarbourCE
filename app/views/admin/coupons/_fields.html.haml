.w-full
  = f.input :name
.w-full    
  = f.input :valid_at, as: :string, input_html: { value: DateTime.now.advance(days: 7), data: { controller: "datepicker", datepicker_max_date_value: DateTime.now.advance(years: 1, days: -1) } }
.w-full  
  = f.input :valid_until, as: :string, input_html: { value: DateTime.now.advance(days: 7), data: { controller: "datepicker", datepicker_max_date_value: DateTime.now.advance(years: 1, days: -1) } }  
.w-full
  = f.input :uuid
.w-full
  = f.input :amount_off
.w-full
  = f.input :percent_off
.w-full
  = f.input :duration_limited
.w-full
  = f.input :redeem_limit
.w-full
  = f.input :duration_in_month
.w-full
  = f.input :plan_id, collection: Plan.all, label_method: :name, value_method: :id, include_blank: false, input_html: { class: "form-control select2-trigger" }, label: "Plans applicables"
.w-full
  = f.input :status, as: :select, collection: Organization.statuses.keys.map { |status| [status.titleize, status] }, include_blank: false
  