:css
  .hero-bg {
    background-image: url('#{asset_path("media/images/2600x1200/bg-1.png")}');
  }
  .dark .hero-bg {
    background-image: url('#{asset_path("media/images/2600x1200/bg-1-dark.png")}');
  }
.bg-center.bg-cover.bg-no-repeat.hero-bg
  / Container
  .kt-container-fluid
    .flex.flex-col.items-center.gap-2.py-4.lg:pt-5.lg:pb-10{:class => "lg:gap-3.5"}
      .flex.items-center{:class => "gap-1.5"}
        .text-lg.leading-5.font-semibold.text-mono
          %i.ki-duotone.ki-ship.text-primary{style: "font-size: 24px;"}
          = organization.name
.kt-container-fluid
  .flex.items-center.flex-wrap.md:flex-nowrap.lg:items-end.justify-between.border-b.border-b-border.gap-3.lg:gap-6.mb-5.lg:mb-10
    .grid
      .kt-scrollable-x-auto
        .kt-menu.gap-3{"data-kt-menu" => "true"}
          - if Current.user.organization_view(organization)
            .kt-menu-item.border-b-2.border-b-transparent.kt-menu-item-active:border-b-primary.kt-menu-item-here:border-b-primary{class: "#{actif=='Organization' ? 'here' : ''}"}
              = link_to member_organization_path(organization), class: "kt-menu-link pb-2 lg:pb-4 px-2 gap-1.5" do
                %span.kt-menu-title.text-nowrap.font-medium.text-sm.text-secondary-foreground.kt-menu-item-active:text-primary.kt-menu-item-active:font-semibold.kt-menu-item-here:text-primary.kt-menu-item-here:font-semibold.kt-menu-item-show:text-primary.kt-menu-link-hover:text-primary
                  = t('.profile')
          - if Permissions::Member::Environments.new(Current.user, :index, organization).index?
            .kt-menu-item.border-b-2.border-b-transparent.kt-menu-item-active:border-b-primary.kt-menu-item-here:border-b-primary{class: "#{actif.downcase=='environments' ? 'here' : ''}"}
              = link_to member_organization_environments_path(organization), class: "kt-menu-link pb-2 lg:pb-4 px-2 gap-1.5" do
                %span.kt-menu-title.text-nowrap.font-medium.text-sm.text-secondary-foreground.kt-menu-item-active:text-primary.kt-menu-item-active:font-semibold.kt-menu-item-here:text-primary.kt-menu-item-here:font-semibold.kt-menu-item-show:text-primary.kt-menu-link-hover:text-primary
                  = t('activerecord.models.environment').pluralize
          .kt-menu-item.border-b-2.border-b-transparent.kt-menu-item-active:border-b-primary.kt-menu-item-here:border-b-primary{class: "#{actif=='projects' ? 'here' : ''}"}
            = link_to member_organization_projects_path(organization), class: "kt-menu-link pb-2 lg:pb-4 px-2 gap-1.5" do
              %span.kt-menu-title.text-nowrap.font-medium.text-sm.text-secondary-foreground.kt-menu-item-active:text-primary.kt-menu-item-active:font-semibold.kt-menu-item-here:text-primary.kt-menu-item-here:font-semibold.kt-menu-item-show:text-primary.kt-menu-link-hover:text-primary
                = t('activerecord.models.project').pluralize
          .kt-menu-item.border-b-2.border-b-transparent.kt-menu-item-active:border-b-primary.kt-menu-item-here:border-b-primary{class: "#{actif=='tokens' ? 'here' : ''}"}
            = link_to member_organization_tokens_path(organization), class: "kt-menu-link pb-2 lg:pb-4 px-2 gap-1.5" do
              %span.kt-menu-title.text-nowrap.font-medium.text-sm.text-secondary-foreground.kt-menu-item-active:text-primary.kt-menu-item-active:font-semibold.kt-menu-item-here:text-primary.kt-menu-item-here:font-semibold.kt-menu-item-show:text-primary.kt-menu-link-hover:text-primary
                = t('activerecord.models.token').pluralize
- if organization.environments.count == 0 and !(controller_name == 'environments' and action_name == "new")
  .kt-container-fluid.mb-4
    %div{:class => "relative border-l-4 p-4 rounded shadow-sm bg-blue-50 text-blue-800 border-blue-300 "}
      %span.font-medium
        It's look like you do not have create an environment yet, please click on the link bellow to create your first one
        %br
        = link_to "Create new environment", new_member_organization_environment_path(I18n.locale, organization), class: "kt-btn kt-btn-outline mt-2"
      %button.absolute.top-2.right-2{:onclick => "this.parentElement.remove()"} ×
- elsif  organization.environments.count > 0 && organization.projects.count == 0 and !(controller_name == 'projects' and action_name == "new")
  .kt-container-fluid.mb-4
    %div{:class => "relative border-l-4 p-4 rounded shadow-sm bg-blue-50 text-blue-800 border-blue-300 "}
      %span.font-medium
        It's look like you do not have create a project yet, please click on the link bellow to create your first one
        %br
        = link_to "Create new project", new_member_organization_project_path(I18n.locale, organization), class: "kt-btn kt-btn-outline mt-2"
      %button.absolute.top-2.right-2{:onclick => "this.parentElement.remove()"} ×