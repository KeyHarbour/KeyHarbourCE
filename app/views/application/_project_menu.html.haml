:css
  .hero-bg {
    background-image: url('#{asset_path("media/images/2600x1200/bg-1.png")}');
  }
  .dark .hero-bg {
    background-image: url('#{asset_path("media/images/2600x1200/bg-1-dark.png")}');
  }
.bg-center.bg-cover.bg-no-repeat.hero-bg
  / Container
  .kt-container-fluid
    .flex.flex-col.items-center.gap-2.py-4.lg:pt-5.lg:pb-10{:class => "lg:gap-3.5"}
      .flex.items-center{:class => "gap-1.5"}
        .text-lg.leading-5.font-semibold.text-mono
          %i.ki-duotone.ki-folder.text-primary{style: "font-size: 24px;"}
          = t('activerecord.models.project').capitalize
          = @project.name
.kt-container-fluid
  .flex.items-center.flex-wrap.md:flex-nowrap.lg:items-end.justify-between.border-b.border-b-border.gap-3.lg:gap-6.mb-5.lg:mb-10
    .grid
      .kt-scrollable-x-auto
        .kt-menu.gap-3{"data-kt-menu" => "true"}
          - if Current.user.project_view(@project)
            .kt-menu-item.border-b-2.border-b-transparent.kt-menu-item-active:border-b-primary.kt-menu-item-here:border-b-primary{class: "#{actif=='projects' ? 'here' : ''}"}
              = link_to member_project_path(@project), class: "kt-menu-link pb-2 lg:pb-4 px-2 gap-1.5" do
                %span.kt-menu-title.text-nowrap.font-medium.text-sm.text-secondary-foreground.kt-menu-item-active:text-primary.kt-menu-item-active:font-semibold.kt-menu-item-here:text-primary.kt-menu-item-here:font-semibold.kt-menu-item-show:text-primary.kt-menu-link-hover:text-primary
                  = t('.profile')
          .kt-menu-item.border-b-2.border-b-transparent.kt-menu-item-active:border-b-primary.kt-menu-item-here:border-b-primary{class: "#{actif=='workspaces' ? 'here' : ''}", "data-kt-menu-item-overflow" => "true", "data-kt-menu-item-placement" => "bottom-start", "data-kt-menu-item-placement-rtl" => "bottom-end", "data-kt-menu-item-toggle" => "dropdown", "data-kt-menu-item-trigger" => "click|lg:hover"}
            = link_to member_project_workspaces_path(@project), class: "kt-menu-link pb-2 lg:pb-4 px-2 gap-1.5" do
              %span.kt-menu-title.text-nowrap.font-medium.text-sm.text-secondary-foreground.kt-menu-item-active:text-primary.kt-menu-item-active:font-semibold.kt-menu-item-here:text-primary.kt-menu-item-here:font-semibold.kt-menu-item-show:text-primary.kt-menu-link-hover:text-primary
                = t('activerecord.models.workspace').pluralize
              %span.kt-menu-arrow
                %i.ki-filled.ki-down.text-xs.text-muted-foreground.menu-item-active:text-primary.kt-menu-item-here:text-primary.menu-item-show:text-primary.kt-menu-link-hover:text-primary
            .kt-menu-dropdown.kt-menu-default.py-2{:class => "min-w-[200px]"}
              .kt-menu-item{class: (controller_name == 'workspaces' && action_name == 'index') ? "active" : ""}
                = link_to member_project_workspaces_path(@project), class: "kt-menu-link" do 
                  %span.kt-menu-title
                    = t('.all_spaces').pluralize
              .border-b.border-input.mt-1.mb-1.mx-3.5
              - @project.workspaces.current_user(Current).each do |workspace|
                - next if workspace.id == nil
                .kt-menu-item{class: @workspace == workspace ? "active" : ""}
                  = link_to member_workspace_path(workspace), class: "kt-menu-link" do 
                    %span.kt-menu-title
                      = workspace.name
          -# .kt-menu-item.border-b-2.border-b-transparent.kt-menu-item-active:border-b-primary.kt-menu-item-here:border-b-primary{class: "#{actif=='keys_store' ? 'here' : ''}"}
            -# %a.kt-menu-link.pb-2.lg:pb-4.px-2{:class => "gap-1.5", :href => "html/demo6/public-profile/network.html"}
            -#   %span.kt-menu-title.text-nowrap.font-medium.text-sm.text-secondary-foreground.kt-menu-item-active:text-primary.kt-menu-item-active:font-semibold.kt-menu-item-here:text-primary.kt-menu-item-here:font-semibold.kt-menu-item-show:text-primary.kt-menu-link-hover:text-primary
            -#     Key/value store
          .kt-menu-item.border-b-2.border-b-transparent.kt-menu-item-active:border-b-primary.kt-menu-item-here:border-b-primary{class: "#{actif=='tokens' ? 'here' : ''}"}
            = link_to member_project_tokens_path(@project), class: "kt-menu-link pb-2 lg:pb-4 px-2 gap-1.5" do
              %span.kt-menu-title.text-nowrap.font-medium.text-sm.text-secondary-foreground.kt-menu-item-active:text-primary.kt-menu-item-active:font-semibold.kt-menu-item-here:text-primary.kt-menu-item-here:font-semibold.kt-menu-item-show:text-primary.kt-menu-link-hover:text-primary
                = t('activerecord.models.token').pluralize                 
- if @project.workspaces.count == 0 && !(controller_name == 'workspaces' and action_name == "new")
  .kt-container-fluid.mb-4
    %div{:class => "relative border-l-4 p-4 rounded shadow-sm bg-blue-50 text-blue-800 border-blue-300 "}
      %span.font-medium
        It's look like you do not have create any workspace yet , please click on the link bellow to create your first one
        %br
        = link_to "Create new workspace", new_member_project_workspace_path(I18n.locale, @project), class: "kt-btn kt-btn-outline mt-2"
      %button.absolute.top-2.right-2{:onclick => "this.parentElement.remove()"} ×                